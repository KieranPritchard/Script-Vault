# --- Stage 1: build subfinder + katana from source, keeps the Go toolchain
# out of the final image (it's ~500MB+ on its own). ---
FROM golang:1.23-bookworm AS tools

RUN go install -v github.com/projectdiscovery/subfinder/v2/cmd/subfinder@latest && \
    go install -v github.com/projectdiscovery/katana/cmd/katana@latest

# --- Stage 2: actual runtime image ---
FROM python:3.11-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Install system utilities required by scripts (nmap, networking tools, etc.)
RUN apt-get update && apt-get install -y --no-install-recommends \
    nmap \
    net-tools \
    iputils-ping \
    dnsutils \
    curl \
    sqlmap \
    dalfox \
    tcpdump \
    build-essential \
    git \
    sqlite3 \
    && rm -rf /var/lib/apt/lists/*

# Pull the compiled subfinder/katana binaries in from the build stage
COPY --from=tools /go/bin/subfinder /usr/local/bin/subfinder
COPY --from=tools /go/bin/katana /usr/local/bin/katana

# Set working directory
WORKDIR /app

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy repository scripts
COPY . .

# Default shell entrypoint
CMD ["/bin/bash"]